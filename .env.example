# LazyFlow AI - Environment Configuration Example
# Copy this file to .env to customize your local configuration.

# Ollama Local Service Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# Backend API Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=true

# Security Note: LazyFlow AI runs 100% locally on your machine.
# No cloud API keys (e.g. OpenAI, Anthropic) are required or supported.
